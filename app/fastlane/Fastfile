default_platform(:ios)

platform :ios do
  desc "Собрать подписанный iOS .ipa и залить в TestFlight (подпись через App Store Connect API key)"
  lane :beta do
    key_path = ENV["ASC_KEY_PATH"]
    key_id   = ENV["ASC_KEY_ID"]
    issuer   = ENV["ASC_ISSUER_ID"]

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer,
      key_filepath: key_path,
      in_house: false,
    )

    # Аутентификация xcodebuild по ASC API-ключу нужна И для archive, И для export,
    # чтобы -allowProvisioningUpdates мог создать/скачать профили (иначе "No Accounts").
    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer}"

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      xcargs: auth,
      export_xcargs: auth,
      output_directory: "dist",
      output_name: "Reed.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end

default_platform(:ios)

platform :ios do
  desc "Собрать подписанный iOS .ipa (App Store) и залить в TestFlight через ASC API key"
  lane :beta do
    key_path = ENV["ASC_KEY_PATH"]
    key_id   = ENV["ASC_KEY_ID"]
    issuer   = ENV["ASC_ISSUER_ID"]

    # Временный keychain для CI (иначе cert/подпись некуда ставить).
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer,
      key_filepath: key_path,
      in_house: false,
    )

    # Подпись через match: сертификат+ключ+профили лежат в приватном git-репо
    # (reed-ios-certs) и переиспользуются каждым прогоном — cert/sigh на
    # эфемерном раннере теряли приватный ключ после каждой сборки.
    match(
      api_key: api_key,
      type: "appstore",
      app_identifier: ["ru.reedapp.app", "ru.reedapp.app.PacketTunnel"],
      git_url: "https://github.com/vikkioleynik09-code/reed-ios-certs.git",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly: false,
    )

    # project.yml держит CURRENT_PROJECT_VERSION="1" статично (XcodeGen-спека в git) —
    # App Store Connect требует уникальный возрастающий номер билда на версию, поэтому
    # берём последний загруженный номер и повышаем на 1 прямо перед сборкой.
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "ru.reedapp.app",
    )
    next_build = latest_build.to_i + 1
    increment_build_number(
      build_number: next_build,
      xcodeproj: "iosApp/iosApp.xcodeproj",
    )
    UI.message("Building iOS build number #{next_build} (latest in TestFlight was #{latest_build})")

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "ru.reedapp.app" => "match AppStore ru.reedapp.app",
          "ru.reedapp.app.PacketTunnel" => "match AppStore ru.reedapp.app.PacketTunnel",
        },
      },
      output_directory: "dist",
      output_name: "Reed.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end
end

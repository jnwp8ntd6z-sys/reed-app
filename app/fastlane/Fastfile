default_platform(:ios)

platform :ios do
  desc "Собрать подписанный iOS .ipa (App Store) и залить в TestFlight через ASC API key"
  lane :beta do
    key_path = ENV["ASC_KEY_PATH"]
    key_id   = ENV["ASC_KEY_ID"]
    issuer   = ENV["ASC_ISSUER_ID"]

    # Временный keychain для CI (иначе cert/подпись некуда ставить).
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer,
      key_filepath: key_path,
      in_house: false,
    )

    # Подпись. Вариант 1 (CI на disifydev): готовые p12 + профили App Store из секретов
    # (SIGN_P12_PATH/PROFILE_*_PATH кладёт шаг workflow). Вариант 2: match из reed-ios-certs.
    profile_prefix = ENV["PROFILE_PREFIX"] || "match AppStore"
    if ENV["SIGN_P12_PATH"]
      import_certificate(
        certificate_path: ENV["SIGN_P12_PATH"],
        certificate_password: ENV["SIGN_P12_PASSWORD"],
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: "",
      )
      install_provisioning_profile(path: ENV["PROFILE_APP_PATH"])
      install_provisioning_profile(path: ENV["PROFILE_EXT_PATH"])
    else
    match(
      api_key: api_key,
      type: "appstore",
      app_identifier: ["ru.reedapp.app", "ru.reedapp.app.PacketTunnel"],
      git_url: "https://github.com/vikkioleynik09-code/reed-ios-certs.git",
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      readonly: false,
    )
    end

    # project.yml держит CURRENT_PROJECT_VERSION="1" статично (XcodeGen-спека в git) —
    # App Store Connect требует уникальный возрастающий номер билда на версию, поэтому
    # берём последний загруженный номер и повышаем на 1 прямо перед сборкой.
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "ru.reedapp.app",
    )
    next_build = latest_build.to_i + 1
    increment_build_number(
      build_number: next_build,
      xcodeproj: "iosApp/Reed.xcodeproj",
    )
    UI.message("Building iOS build number #{next_build} (latest in TestFlight was #{latest_build})")

    build_app(
      project: "iosApp/Reed.xcodeproj",
      scheme: "Reed",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "ru.reedapp.app" => "#{profile_prefix} ru.reedapp.app",
          "ru.reedapp.app.PacketTunnel" => "#{profile_prefix} ru.reedapp.app.PacketTunnel",
        },
      },
      output_directory: "dist",
      output_name: "Reed.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end

  desc "Отправить сборку из TestFlight на ревью App Store (BUILD_NUMBER, по умолчанию — последняя версии APP_VERSION)"
  lane :submit do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
      in_house: false,
    )
    version = ENV["APP_VERSION"].to_s.empty? ? "2.0" : ENV["APP_VERSION"]
    build = ENV["BUILD_NUMBER"].to_s
    if build.empty?
      build = latest_testflight_build_number(api_key: api_key, app_identifier: "ru.reedapp.app", version: version).to_s
    end

    # Сборка только что залита — ждём, пока App Store Connect её обработает (до ~40 минут).
    app = Spaceship::ConnectAPI::App.find("ru.reedapp.app")
    UI.user_error!("Приложение ru.reedapp.app не найдено в App Store Connect") unless app
    state = nil
    80.times do
      b = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build).first
      state = b&.processing_state
      UI.message("Сборка #{version} (#{build}): #{state || 'ещё не видна'}")
      break if state == "VALID"
      UI.user_error!("Сборка #{build}: #{state}") if %w[FAILED INVALID].include?(state)
      sleep 30
    end
    UI.user_error!("Сборка #{build} так и не обработалась (#{state})") unless state == "VALID"

    # После отказа прошлая подача остаётся открытой (UNRESOLVED_ISSUES) — новую создать нельзя.
    # Ставим новую сборку в версию и повторно подаём ту же подачу («Resubmit to App Review»).
    open_subs = app.get_review_submissions(
      filter: { state: "UNRESOLVED_ISSUES,READY_FOR_REVIEW", platform: "IOS" }, includes: "items"
    )
    unless open_subs.empty?
      ver = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
      UI.user_error!("Нет редактируемой версии App Store") unless ver
      b = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build).first
      ver.select_build(build_id: b.id)
      UI.message("Версия #{ver.version_string}: выбрана сборка #{build}")
      sub = open_subs.first
      UI.message("Открытая подача #{sub.id} (#{sub.state}) — отправляю повторно")
      sub.submit_for_review
      UI.success("Сборка #{version} (#{build}) повторно отправлена на ревью")
      next
    end

    deliver(
      api_key: api_key,
      app_identifier: "ru.reedapp.app",
      app_version: version,
      build_number: build,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
    )
    UI.success("Сборка #{version} (#{build}) отправлена на ревью")
  end
end

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Reed Client — всегда тёмная тема. Фон окна брендовый тёмный, чтобы при запуске не
         мелькало белое окно. Цвета баров не задаём (Play Console: устаревшие атрибуты) —
         прозрачность и edge-to-edge включает AppActivity через enableEdgeToEdge. -->
    <style name="Theme.Reed" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/reed_window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
